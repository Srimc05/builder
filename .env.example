# Copy to .env.local (git-ignored) and fill in.

# JSON POST endpoint that receives enquiry form submissions
# (e.g. a Formspree/Basin/Getform form endpoint or your own API).
# When empty, forms show a clear "not connected yet" message — they never fake success.
VITE_ENQUIRY_ENDPOINT=

# Placeholder projects, testimonials and articles live in src/content/sample.
# They are included in development and in `npm run build:showcase`,
# and not bundled by `npm run build` (production) unless this is "true".
VITE_INCLUDE_SAMPLE_CONTENT=
